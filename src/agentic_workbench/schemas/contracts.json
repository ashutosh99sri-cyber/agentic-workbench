{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "source_hash"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "Finding": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "details", "kind", "severity", "evidence"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "details": {"type": "string", "maxLength": 4000},
        "kind": {"enum": ["fact", "inference", "unknown"]},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "evidence": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/Evidence"}}
      }
    },
    "Usage": {
      "type": "object", "additionalProperties": false,
      "required": ["requests", "input_tokens", "output_tokens", "unknown_receipts", "estimated_cost_usd"],
      "properties": {
        "requests": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "unknown_receipts": {"type": "integer", "minimum": 0},
        "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "CandidateEdit": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "base_hash", "content", "delete"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "base_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "content": {"type": ["string", "null"], "maxLength": 1048576},
        "delete": {"type": "boolean"}
      }
    },
    "ModelAnalysis": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "findings", "recommendations", "candidate_edits", "limitations"],
      "properties": {
        "summary": {"type": "string", "maxLength": 8000},
        "findings": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/Finding"}},
        "recommendations": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 2000}},
        "candidate_edits": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/CandidateEdit"}},
        "limitations": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 2000}}
      }
    },
    "AgentResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "task_id", "agent", "mode", "summary", "evidence", "findings", "recommendations", "proposal_ids", "limitations", "usage"],
      "properties": {
        "schema_version": {"const": 1},
        "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "agent": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "mode": {"enum": ["static", "llm"]},
        "summary": {"type": "string", "maxLength": 16000},
        "evidence": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/Evidence"}},
        "findings": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/Finding"}},
        "recommendations": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 4000}},
        "proposal_ids": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 128}},
        "limitations": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 4000}},
        "usage": {"$ref": "#/$defs/Usage"}
      }
    }
  }
}
